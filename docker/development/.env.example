# Optional overrides for the development database.
# Every value here has a working default in docker-compose.yml, so you only need
# this file if you want to change one (e.g. 5432 is already taken on your host).
#
#   cp .env.example .env

POSTGRES_DB=fcm
POSTGRES_USER=fcm
POSTGRES_PASSWORD=fcm
POSTGRES_PORT=5432
