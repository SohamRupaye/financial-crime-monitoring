# Copy to .env and fill in real values before starting the production stack.
#   cp .env.example .env
#
# .env is gitignored. Do not commit real credentials. For an actual deployment
# prefer your platform's secret store (Docker/Kubernetes secrets, SSM, Vault)
# over a file on disk.

# Required — compose refuses to start if any of these are unset.
POSTGRES_DB=fcm
POSTGRES_USER=fcm
# Generate one, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional.
APP_PORT=8080
APP_VERSION=0.0.1-SNAPSHOT
SPRING_PROFILES_ACTIVE=production
